# piighost-api configuration
# Copy to .env and adjust values as needed:
#   cp .env.example .env

# ── Server ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# ── Pipeline ────────────────────────────────────────────
# A piighost TOML or JSON configuration file, or a hub reference such as
# hub:piighost/support-en:286909f6 (a pinned commit is fetched once, then
# cached). A configuration without a [memory] section is served with the
# in-process memory, which holds threads for one worker only.
PIIGHOST_CONFIG=/app/pipeline.toml

# ── Authentication ─────────────────────────────────────
# The server refuses to start without at least one API_KEY_<name> entry,
# unless PIIGHOST_ALLOW_ANONYMOUS is true. Generate a pepper and a key with
# keyshield, then set the pepper and the hashed key below.
SECRET_PEPPER=
API_KEY=
PIIGHOST_ALLOW_ANONYMOUS=

# ── Limits ─────────────────────────────────────────────
# Largest request body, in bytes. A larger one is refused with 413.
PIIGHOST_MAX_BODY_BYTES=1000000
# Per-client rate limit as <unit>:<count>, e.g. minute:300. Unset disables it.
PIIGHOST_RATE_LIMIT=

# ── Proxies ────────────────────────────────────────────
# Default upstreams, overridden per request by the X-PIIGhost-Upstream header.
PIIGHOST_OPENAI_UPSTREAM=https://api.openai.com/v1
PIIGHOST_ANTHROPIC_UPSTREAM=https://api.anthropic.com/v1

# ── Runtime extras ─────────────────────────────────────
# Installed by entrypoint.sh inside the container at startup, without
# rebuilding the image. A GLiNER2 configuration needs "piighost[gliner2]",
# an encrypted redis memory "piighost[crypto]".
EXTRA_PACKAGES=

# ── Observation (optional) ─────────────────────────────
# Spans are exported over OTLP when an endpoint is set (Langfuse, Phoenix,
# any OTLP-compatible backend). Needs the observation extra.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=piighost-api

# ── Dataset CLI (optional) ─────────────────────────────
# Read by `piighost-api dataset extract` only, to fetch traces from Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
